APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-before-first-run
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=10485760
# Docker publishes to loopback by default. Change a bind address only behind a
# TLS-terminating reverse proxy or when the network exposure is intentional.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
# Leave empty for the Docker/Vite same-origin API proxy. Set an external API origin only when needed.
VITE_API_URL=
# MySQL Community Edition. Docker Compose supplies MYSQL_PASSWORD to the
# backend as DATABASE_PASSWORD, so generated passwords may contain URL-reserved
# characters such as @, :, /, or #.
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
MYSQL_PASSWORD=replace-with-an-app-password
MYSQL_PORT=3306
# Host-side scripts and a manually started backend use these values. Compose
# overrides the host with its internal mysql service name. Keep
# DATABASE_PASSWORD equal to MYSQL_PASSWORD.
DATABASE_URL=mysql://novaledger@127.0.0.1:3306/novaledger
DATABASE_PASSWORD=replace-with-an-app-password
